[1.217, "o", "---\r\ntitle: Sample paper\r\n---\r\n\r\nThe tidyverse [@doi:10.21105/joss.01686] is a coherent grammar for data\r\nmanipulation in R. Single-cell integration approaches like Seurat\r\n[@doi:10.1101/460147] handle the bioRxiv preprint side. Transformer\r\narchitectures [@arxiv:1706.03762] underlie current AI tooling, and\r\n"]
[1.209, "o", "\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m quartobot scan .\r\n"]
[1.258, "o", "arxiv:\r\n  1706.03762\r\ndoi:\r\n  10.1101/460147\r\n  10.21105/joss.01686\r\npmid:\r\n  23715323\r\n\r\n4 unique key(s), 4 total occurrence(s) across 1 file(s).\r\n"]
[1.213, "o", "\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m quartobot resolve --from-scan . --output references.json --id-mode citation-key\r\n"]
[3.216, "o", "  ✓ doi:10.21105/joss.01686 → EWll2pyF\r\n  ✓ doi:10.1101/460147 → w1M2PfcJ\r\n  ✓ arxiv:1706.03762 → Exfv0f4l\r\n  ✓ pubmed:23715323 → tkedgOHV\r\n\r\n4 resolved. Wrote 4 entries to references.json.\r\n"]
[1.223, "o", "\r\n\u001b[1;32m$\u001b[0m head -25 references.json\r\n"]
[1.212, "o", "[\r\n  {\r\n    \"id\": \"arxiv:1706.03762\",\r\n    \"URL\": \"https://arxiv.org/abs/1706.03762\",\r\n    \"number\": \"1706.03762\",\r\n    \"title\": \"Attention Is All You Need\",\r\n    \"issued\": {\r\n      \"date-parts\": [\r\n        [\r\n          2023,\r\n          8,\r\n          3\r\n        ]\r\n      ]\r\n    },\r\n    \"author\": [\r\n      {\r\n        \"given\": \"Ashish\",\r\n        \"family\": \"Vaswani\"\r\n      },\r\n      {\r\n        \"given\": \"Noam\",\r\n        \"family\": \"Shazeer\"\r\n      },\r\n      {\r\n"]
